---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import {posts,tags,tagSlug} from '../../lib/posts';
export function getStaticPaths(){return tags.map(tag=>({params:{tag:tagSlug(tag)},props:{tag}}))}
const {tag}=Astro.props;
---
<Base title={`${tag} · Yangyang`}><section class="section-wrap listing"><a class="eyebrow" href="/tags/">主题索引 /</a><h1>{tag}</h1><PostList posts={posts.filter(p=>p.tags.includes(tag))}/></section></Base>
