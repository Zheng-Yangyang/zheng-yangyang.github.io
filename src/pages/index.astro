---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import {posts,categories} from '../lib/posts';
const featured=posts.find(p=>p.slug==='agent/concept')||posts[0];
---
<Base><section class="hero"><div class="hero-top"><span class="eyebrow">A PERSONAL NOTEBOOK / 持续更新中</span><span class="hero-index">01 — 思考与构建</span></div><div class="hero-grid"><div><h1>保持好奇。<br/>把想法<span class="serif-accent">写下来。</span></h1><p class="hero-english">Think deeply.<br/><em>Build something.</em></p></div><div class="hero-note"><span class="little-star" aria-hidden="true">✳</span><p>你好，我是 Yangyang。<br/>在代码与生活之间，<br/>记录一些值得留下的思考。</p><span class="muted">AI · 软件工程 · 学习笔记</span><a class="text-link" href="/posts/">翻开我的笔记 <span>↗</span></a></div></div><div class="hero-bottom"><span>探索、实践，然后理解。</span><span>SCROLL TO EXPLORE ↓</span></div></section><section class="section-wrap"><div class="section-heading"><div><span class="eyebrow">EXPLORE BY TOPIC</span><h2>沿着兴趣，继续探索</h2></div><span class="muted">一个慢慢生长的知识花园。</span></div><div class="topic-grid">{categories.map((c,i)=><a class="topic" href={`/posts/${c.id}/`}><div class="topic-top"><span class="topic-symbol">{c.symbol}</span><span class="eyebrow">0{i+1} / {posts.filter(p=>p.category===c.id).length} 篇</span></div><h3>{c.name}</h3><p>{c.subtitle}</p><span class="topic-arrow">↗</span></a>)}</div></section><section class="section-wrap journal"><div><div class="section-heading"><div><span class="eyebrow">LATEST ENTRIES</span><h2>最近写下的</h2></div><a class="text-link small" href="/posts/">全部笔记 ↗</a></div><PostList posts={posts.slice(0,5)}/></div><aside class="featured"><span class="eyebrow">EDITOR'S PICK / 推荐阅读</span><span class="featured-star" aria-hidden="true">✳</span><h2>从概念开始，<br/>理解 Agent。</h2><p>{featured.description}</p><a href={featured.url}>阅读这篇笔记 ↗</a><div class="featured-bottom">THINKING IN SYSTEMS<br/><span>复杂的事，也可以一点点弄懂。</span></div></aside></section><section class="closing"><span class="eyebrow">LEARN IN PUBLIC</span><p>理解世界的方式，<br/>是不断<span>提问与尝试。</span></p><a href="https://github.com/Zheng-Yangyang">看看我正在构建什么 ↗</a></section></Base>
